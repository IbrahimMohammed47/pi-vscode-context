{
  "name": "pi-vscode-context-vscode",
  "displayName": "Pi VS Code Context",
  "description": "Expose active editor context, Integrated Browser element context, and diagnostics to Pi on demand.",
  "version": "0.1.1",
  "publisher": "IbrahimMohammed",
  "author": "Ibrahim Mohammed",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/IbrahimMohammed47/pi-vscode-context#readme",
  "bugs": {
    "url": "https://github.com/IbrahimMohammed47/pi-vscode-context/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IbrahimMohammed47/pi-vscode-context.git",
    "directory": "packages/vscode-extension"
  },
  "keywords": [
    "pi",
    "AI",
    "context",
    "diagnostics",
    "local"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:pi-vscode-context.captureBrowserSelection"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-vscode-context.captureBrowserSelection",
        "title": "Pi: Pick Integrated Browser Element",
        "enablement": "activeEditor == workbench.editor.browser",
        "icon": "$(inspect)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-vscode-context.captureBrowserSelection",
          "group": "navigation@1",
          "when": "activeEditor == workbench.editor.browser"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check server.js && node --check context.js && node --check diagnostics.js && node --check editor.js && node --check browserSelection.js && node --check browserPicker.js",
    "package": "vsce package --no-dependencies --out pi-vscode-context-vscode-${npm_package_version}.vsix",
    "test": "node --test"
  }
}
